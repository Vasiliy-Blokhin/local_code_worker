=== new: elements/alg_registry.py
"""Registry of all algorithm implementations.

This module collects all algorithm classes and exposes them through a
simple dictionary ``ALGORITHMS`` and a helper function ``get_algorithm``.
The goal is to provide a single place where all algorithm types can
be discovered without having to import many different modules.

The registry is intentionally lightweight and does not alter the
behaviour of existing algorithms.  It simply provides a unified
interface for lookup.
"""

from elements.algorithm.worker import Algorithm as StrategyAlgorithm
from elements.reverse.worker import ReverseAlgorithm
from elements.evolve.worker import Evolver as EvolveAlgorithm
from elements.selftune.worker import SelfTuner
from elements.selector.worker import StrategySelector
from elements.rotation.worker import Rotation

# Mapping of algorithm names to their implementations.
ALGORITHMS = {
    "strategy": StrategyAlgorithm,
    "reverse": ReverseAlgorithm,
    "evolve": EvolveAlgorithm,
    "selftune": SelfTuner,
    "selector": StrategySelector,
    "rotation": Rotation,
}


def get_algorithm(name: str):
    """Return the algorithm implementation for *name*.

    Parameters
    ----------
    name: str
        Name of the algorithm.  Must be one of the keys in :data:`ALGORITHMS`.

    Returns
    -------
    class
        The algorithm class.

    Raises
    ------
    KeyError
        If the requested algorithm is not registered.
    """
    return ALGORITHMS[name]

__all__ = ["ALGORITHMS", "get_algorithm"]
=== new: elements/common/describe.py
def format_stats(stats: dict, *, prefix: str = '', halves: list | None = None, holdout: dict | None = None) -> str:
    """Format statistics into a human-readable string.

    Parameters
    ----------
    stats: dict
        Dictionary containing at least ``CAGR``, ``MAX_DRAWDOWN`` and ``TRADES``.
        Optionally may contain ``SHARPE``.
    prefix: str, optional
        Prefix to prepend to the description (e.g. "поиск").
    halves: list, optional
        List of two dicts with ``CAGR`` key used for half‑period reporting.
    holdout: dict, optional
        Dictionary with ``CAGR`` and ``TRADES`` for hold‑out statistics.

    Returns
    -------
    str
        Formatted description.
    """
    parts = []
    if prefix:
        parts.append(prefix)
    base = f'CAGR {stats["CAGR"]:+.1%}, просадка {stats["MAX_DRAWDOWN"]:.1%}, сделок {stats["TRADES"]}'
    if "SHARPE" in stats:
        base += f', Sharpe {stats["SHARPE"]:.2f}'
    if halves:
        base += f', половины {halves[0]["CAGR"]:+.1%}/{halves[1]["CAGR"]:+.1%}'
    if holdout:
        base += f'; контроль CAGR {holdout["CAGR"]:+.1%} ({holdout["TRADES"]} сд.)'
    return base
