+def test_private_ips_excluded_from_counts(guard, monkeypatch):
+    # Set a low total limit and mix private/public IPs
+    monkeypatch.setattr(watch.settings, "guard_total_limit", 5)
+    # 3 public IPs, 3 private IPs
+    append(guard, [line(T0 + i, ip=f"7.7.7.{i}") for i in range(3)])
