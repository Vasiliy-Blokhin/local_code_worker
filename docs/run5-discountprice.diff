 from app.config import settings
 
+# Helper to detect local IP addresses
+def is_local_ip(ip: str) -> bool:
+    """Return True if ip is a private or loopback address.
+    Handles IPv4 127.*, 192.168.*, 10.* and IPv6 ::1.
+    """
+    return ip.startswith("127.") or ip.startswith("192.168.") or ip.startswith("10.") or ip == "::1"
+
