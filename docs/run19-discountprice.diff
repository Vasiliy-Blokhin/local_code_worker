@@ -161,3 +162,36 @@ def test_bot_commands(tmp_path, monkeypatch):
     assert "открыт" in commands.handle("/guard")
     assert "закрыт" in commands.handle("/close") and g.is_closed()
     assert "снята" in commands.handle("/open") and not g.is_closed()
+
+# New tests for private IP handling
+
+def test_ignore_private_ips(tmp_path):
+    guard = Guard(Path('dummy.log'), Path(tmp_path), from_end=False)
+    # Feed private IPs
+    for i in range(10):
+        guard.feed([line(0, ip='127.0.0.1', uri=f'/x{i}.php', status=404)])
+    # Feed a public IP
+    guard.feed([line(0, ip='8.8.8.8', uri='/x.php', status=404)])
+    v = guard.analyze()
+    # Only public IP should be counted
+    assert v.total == 1
+    assert v.by_status[404] == 1
+    assert v.suspicious == 1
+    assert v.scanners == [('8.8.8.8', 1)]
+    assert not v.close
+
+
+def test_private_ip_boundary(tmp_path):
+    guard = Guard(Path('dummy.log'), Path(tmp_path), from_end=False)
+    # 172.16.0.1 is private
+    guard.feed([line(0, ip='172.16.0.1', uri='/x.php', status=404)])
+    v = guard.analyze()
+    assert v.total == 0
+
+
+def test_is_private_ip_function():
+    assert is_private_ip('127.0.0.1')
+    assert is_private_ip('10.0.0.5')
+    assert is_private_ip('192.168.1.100')
+    assert not is_private_ip('8.8.8.8')
+    assert not is_private_ip('2001:4860:4860::8888')
