+
+# new tests for internal IP filtering
+
+def test_internal_ip_filtering(guard, no_db, monkeypatch):
+    # set low total limit to trigger close if internal counted
+    monkeypatch.setattr(watch.settings, "guard_total_limit", 1)
+    # add internal IP hit
+    append(guard, [line(T0, ip="127.0.0.1")])
+    msgs = guard.tick(now=T0 + 1)
+    assert not guard.is_closed()
+    # add external IP hit
+    append(guard, [line(T0 + 2, ip="8.8.8.8")])
+    msgs = guard.tick(now=T0 + 3)
+    assert guard.is_closed()
+    assert "closed" in [e[0] for e in no_db]
+
+# boundary test: IP at edge of internal range
+
+def test_internal_ip_range_boundary(guard, no_db, monkeypatch):
+    monkeypatch.setattr(watch.settings, "guard_total_limit", 1)
+    # IP exactly 192.168.0.0 should be considered internal
+    append(guard, [line(T0, ip="192.168.0.0")])
+    msgs = guard.tick(now=T0 + 1)
+    assert not guard.is_closed()
+    # IP just outside: 192.168.1.0 should be external
+    append(guard, [line(T0 + 2, ip="192.168.1.0")])
+    msgs = guard.tick(now=T0 + 3)
+    assert guard.is_closed()
+    assert "closed" in [e[0] for e in no_db]
+
+# test internal IP detection
+
+def test_internal_ip_detection():
+    from app.guard.watch import _is_internal_ip
+    assert _is_internal_ip("127.0.0.1")
+    assert _is_internal_ip("192.168.1.1")
+    assert not _is_internal_ip("8.8.8.8")
