+# New tests for 200 status handling
+def test_suspicious_200_not_counted(guard, no_db):
+    append(guard, [line(T0, uri="/?q=1%20UNION%20SELECT%20password", status=200)])
+    msgs = guard.tick(now=T0 + 1)
+    assert msgs == []
+    assert guard.is_closed() == False
+    assert no_db == []
+
+def test_mixed_status_counts_only_non200(guard, no_db):
+    lines = [line(T0, uri="/?q=1%20UNION%20SELECT%20password", status=200)]
+    lines += [line(T0, uri="/?q=1%20UNION%20SELECT%20password", status=404) for _ in range(25)]
+    append(guard, lines)
+    msgs = guard.tick(now=T0 + 1)
+    assert msgs != []
+    assert guard.is_closed() == False
+    assert [e[0] for e in no_db] == ['scan']
+
+def test_non_suspicious_200_no_alert(guard, no_db):
+    append(guard, [line(T0, uri="/index.html", status=200)])
+    msgs = guard.tick(now=T0 + 1)
+    assert msgs == []
+    assert guard.is_closed() == False
+    assert no_db == []
+
+def test_many_200_suspicious_no_close(guard, no_db):
+    lines = [line(T0 + i*0.1, uri="/?q=1%20UNION%20SELECT%20password", status=200) for i in range(50)]
+    append(guard, lines)
+    msgs = guard.tick(now=T0 + 5)
+    assert msgs == []
+    assert guard.is_closed() == False
+    assert no_db == []
+
+def test_mixed_200_no_alert(guard, no_db):
+    append(guard, [line(T0, uri="/?q=1%20UNION%20SELECT%20password", status=200),
+                  line(T0, uri="/index.html", status=200)])
+    msgs = guard.tick(now=T0 + 1)
+    assert msgs == []
+    assert guard.is_closed() == False
+    assert no_db == []
+
+
