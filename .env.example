# Адрес веб-интерфейса. 0.0.0.0 — доступ из локальной сети (тогда обязательно задайте пароль!)
LCW_HOST=127.0.0.1
LCW_PORT=9009
# Пароль веб-интерфейса (агент выполняет команды на этой машине)
LCW_PASSWORD=

# AI Manager
AIM_URL=http://127.0.0.1:8000
AIM_PASSWORD=change-me
LCW_MODEL=gpt-oss-20b
# Должен совпадать с "context" модели в реестре AI Manager
LCW_CONTEXT=100000
# Имя проекта в очереди задач AI Manager (видно в GET /api/jobs)
# LCW_AIM_PROJECT=local_code_worker

# Поведение агента
LCW_REASONING=low          # low | medium | high — по умолчанию для новых сессий
LCW_MAX_TOKENS=8192        # лимит одного ответа модели
LCW_MAX_STEPS=50           # шагов агента на один запрос
LCW_COMMAND_TIMEOUT=180    # секунд на команду run
LCW_COMPACT_AT=0.75        # авто-сжатие истории при заполнении контекста на 75%
# LCW_DATA_DIR=data        # сессии, список проектов, клоны репозиториев
